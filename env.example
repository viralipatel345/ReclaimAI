GEMINI_API_KEY=
DEMO_MODE=true
# GEMINI_MODEL=gemini-3.1-pro-preview
# GEMINI_FALLBACK_MODEL=gemini-flash-latest

# Shared secret Cloud Scheduler sends as x-reclaim-cron to POST /api/recheck
RECHECK_CRON_SECRET=
# Optional: Programmable Search for the own-name check (stubbed when unset)
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_ID=

# ---- Incident verification platform (feature/incident-verification) ----
# Auth (pick one): supabase | firebase | auth0
AUTH_PROVIDER=supabase
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# FIREBASE_WEB_API_KEY=
# AUTH0_DOMAIN=

# Human verification (pick one). Token is sent as header x-human-token.
# TURNSTILE_SECRET_KEY=
# RECAPTCHA_PROJECT_ID=
# RECAPTCHA_API_KEY=
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_MIN_SCORE=0.5

# SynthID detector on Vertex AI: full predict URL of the deployed detector endpoint.
# Token via google-auth-library (GOOGLE_APPLICATION_CREDENTIALS) or VERTEX_ACCESS_TOKEN.
# SYNTHID_ENDPOINT=https://us-central1-aiplatform.googleapis.com/v1/projects/PROJECT/locations/us-central1/endpoints/ENDPOINT:predict
# VERTEX_ACCESS_TOKEN=

# Context engine / scraper (first configured wins): Tavily, SerpAPI, or Google CSE above.
# TAVILY_API_KEY=
# SERPAPI_API_KEY=

# Parasell direct integration (API key, or OAuth 2.0 client credentials)
# PARASELL_API_KEY=
# PARASELL_CLIENT_ID=
# PARASELL_CLIENT_SECRET=
# PARASELL_API_URL=https://api.parasell.com/v1/reports
# PARASELL_TOKEN_URL=https://api.parasell.com/oauth/token

# Postgres for prisma/schema.prisma (runtime uses the in-memory store until wired)
# DATABASE_URL=postgresql://user:pass@localhost:5432/reclaim

# Reverse image search ("Find my image online"): Google Cloud Vision Web Detection.
# Free tier covers ~1,000 images/month. Without it, demo mode uses a fictional fixture.
# GOOGLE_VISION_API_KEY=
