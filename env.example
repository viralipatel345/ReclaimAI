GEMINI_API_KEY=
DEMO_MODE=true
# GEMINI_MODEL=gemini-3.1-pro-preview
# GEMINI_FALLBACK_MODEL=gemini-flash-latest

# Shared secret Cloud Scheduler sends as x-reclaim-cron to POST /api/recheck
RECHECK_CRON_SECRET=
# Optional: Programmable Search for the own-name check (stubbed when unset)
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_ID=

# Real mode (DEMO_MODE unset/false)
# OAuth 2.0 Web client ID for Google sign-in (Gmail send + read). Public by design.
# GOOGLE_CLIENT_ID=
# When set, every request email goes to this team inbox, labeled as standing in for the platform.
# TEST_PLATFORM_INBOX=
