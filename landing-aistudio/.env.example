# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Where "Start with a link" sends people (the deployed Reclaim app). Falls back to the on-page demo.
VITE_APP_URL=

# Real "Sign in with Google" for sending (Gmail send + read). Same OAuth web client as the
# real app's GOOGLE_CLIENT_ID. This preview's origin must be added to that client's
# Authorized JavaScript origins in Google Cloud Console, or sign-in fails.
VITE_GOOGLE_CLIENT_ID=
# Base URL of the deployed Next.js app, so identity verification can call its real
# /api/verify-identity route (Document AI). Same value works for VITE_APP_URL above.
VITE_API_BASE=
